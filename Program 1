def to_8bit_binary(n):
    """Convert an integer to 8-bit 2's complement."""
    return format(n & 0xFF, '08b')


def signed_binary_arithmetic(a, b, operation):
    # Check whether operands fit in 8-bit signed range
    if not (-128 <= a <= 127 and -128 <= b <= 127):
        print("Error: Operand is outside the 8-bit signed range.")
        return

    # Perform the operation
    if operation == '+':
        result = a + b
    elif operation == '-':
        result = a - b
    else:
        print("Invalid operation")
        return

    # Convert subtraction to an effective addition
    effective_b = b if operation == '+' else -b

    # Display operands
    print("First operand :", to_8bit_binary(a), "(", a, ")")
    print("Second operand:", to_8bit_binary(b), "(", b, ")")

    # Show the effective binary operation
    print("Effective second operand:", to_8bit_binary(effective_b))
    print("Operation:", operation)

    # Check arithmetic overflow
    overflow = not (-128 <= result <= 127)

    # Display the 8-bit result (wrapped representation)
    binary_result = to_8bit_binary(result)
    signed_result = result if result <= 127 and result >= -128 else (
        result - 256 if result > 127 else result + 256
    )

    print("Result (8-bit binary):", binary_result)
    print("Result (decimal):", signed_result)

    if overflow:
        print("Arithmetic overflow: YES")
        print("True mathematical result:", result)
    else:
        print("Arithmetic overflow: NO")


print("Expression 1: (+48) + (+23)")
signed_binary_arithmetic(48, 23, '+')

print("\nExpression 2: (-46) - (-29)")
signed_binary_arithmetic(-46, -29, '-')
