def rotate_right(value, positions):
    print("\nA) Rotate Right without Carry (ROR)")
    print("Original binary number:", value)

    for step in range(1, positions + 1):
        # Move the rightmost bit to the leftmost position
        value = value[-1] + value[:-1]
        print(f"After rotation {step}: {value}")

    print("Final ROR result:", value)


def rotate_right_carry(value, positions, carry):
    print("\nB) Rotate Right Through Carry (RCR)")
    print("Original binary number:", value)
    print("Initial carry flag:", carry)

    for step in range(1, positions + 1):
        # Save the rightmost bit as the new carry
        new_carry = int(value[-1])

        # Insert the old carry into the leftmost bit
        value = str(carry) + value[:-1]
        carry = new_carry

        print(f"After rotation {step}: {value}, Carry = {carry}")

    print("Final RCR result:", value)
    print("Final carry flag:", carry)


binary = "11010101"
positions = 2
initial_carry = 0

rotate_right(binary, positions)
rotate_right_carry(binary, positions, initial_carry)
